# Copia este archivo como .env.local y llena los valores.
# .env.local NO se sube a git. En Vercel, estas mismas variables van en
# Settings → Environment Variables.

# ── Acceso al creador ───────────────────────────────────────────────
# Clave compartida para crear portafolios. No son cuentas:
# la página pública /p/... sigue abierta para todos.
# Mínimo 24 caracteres. Genérala con:  openssl rand -base64 32
CREATOR_ACCESS_KEY=

# ── Instagram con Apify (importar perfiles) ─────────────────────────
# console.apify.com → Settings → API & Integrations → Personal API tokens.
# Cobra por uso (~US$0,003 por importación): pon un tope mensual en Billing → Limits.
APIFY_TOKEN=

# ── Textos con IA en Groq (propuesta de valor, títulos y nichos) ────
# console.groq.com → API Keys → Create API Key. Tope de gasto: Settings → Spend Limits.
GROQ_API_KEY=

# ── Almacenamiento ──────────────────────────────────────────────────
# En Vercel: conecta un Blob store con acceso PRIVATE al proyecto y Vercel
# agrega solo sus credenciales. No las copies aquí.
# En tu compu se guarda en la carpeta .data/ del proyecto.
# Solo si de verdad quieres usar el Blob store desde tu compu, descomenta
# la línea de abajo y trae BLOB_READ_WRITE_TOKEN con: vercel env pull .env.local
# STORAGE_DRIVER=blob

# ── Correos del programa piloto → Google Sheets (ronda 30/09 · 8.4) ──
# Opcionales: sin ellas, los correos quedan en MODO MOCK (pilot-sheet-mock/). Paso a paso en DEPLOY.md §4.1.
# La clave privada va tal cual sale del JSON de la cuenta de servicio (con sus \n).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_RANGE=Piloto!A:C
